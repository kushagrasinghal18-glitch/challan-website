# ── Server ───────────────────────────────────────────────
PORT=8787
# Long random string used to sign the session token issued after OTP verification.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Challan data source ─────────────────────────────────
# mock       = built-in sample data (default, no keys needed)
# instantpay = InstantPay Vehicle Challan API (set the INSTANTPAY_* values below)
# http       = any other provider, configured with the CHALLAN_API_* values below
CHALLAN_PROVIDER=mock
# If the live provider fails, serve mock data instead of the "we'll check manually" screen.
# Keep this false in production so customers never see fake challans.
CHALLAN_FALLBACK_TO_MOCK=false
# Max paid lookups per day (India time). Protects your InstantPay balance. 0 = no limit.
MAX_LIVE_LOOKUPS_PER_DAY=100

# ── InstantPay (CHALLAN_PROVIDER=instantpay) ────────────
# From your InstantPay dashboard. Each successful lookup is debited from your pool.
INSTANTPAY_CLIENT_ID=
INSTANTPAY_CLIENT_SECRET=
# Location sent with each lookup (required by InstantPay). Defaults to Noida.
INSTANTPAY_LATITUDE=28.5355
INSTANTPAY_LONGITUDE=77.3910
# Only change if InstantPay gives you a different endpoint.
# INSTANTPAY_API_URL=https://api.instantpay.in/identity/vehicleChallan
# Set to 1 (or true) when hosted behind a load balancer, so the customer's real IP
# is sent to InstantPay instead of the balancer's.
TRUST_PROXY=

# ── Generic provider (CHALLAN_PROVIDER=http) ────────────
# Provider endpoint. {plate} is replaced with the vehicle number (no spaces).
CHALLAN_API_URL=https://api.example.com/v1/challans?vehicle={plate}
CHALLAN_API_METHOD=GET
# For POST providers: JSON body template, {plate} is substituted.
CHALLAN_API_BODY={"vehicle_number":"{plate}"}
CHALLAN_API_KEY=
# Header that carries the key, e.g. x-api-key or Authorization
CHALLAN_API_KEY_HEADER=x-api-key
# Prefix for the key value, e.g. "Bearer " (include the trailing space)
CHALLAN_API_KEY_PREFIX=
# Dot path to the array of challans in the response, e.g. data.challans or result
CHALLAN_API_LIST_PATH=data
CHALLAN_API_TIMEOUT_MS=15000

# ── OTP ──────────────────────────────────────────────────
# demo    = any 6 digits are accepted (prototype behaviour)
# console = a real 6-digit code is generated and printed in the server log
OTP_MODE=demo

# ── Front end (read at build time by Vite) ───────────────
# noida | ghaziabad | delhi | gurugram
VITE_CITY=noida
VITE_BRAND=Niptao
VITE_DEFAULT_LANG=en
VITE_PHONE=+910000000000
VITE_WHATSAPP=910000000000
VITE_EMAIL=hello@example.in
